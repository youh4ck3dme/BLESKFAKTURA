{
  "hosting": {
    "site": "bleskova-faktura-legal-356987",
    "public": "hosting/legal",
    "ignore": [
      "firebase.legal.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",

+package com.example.ui.efaktura
+
+import android.net.Uri
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.example.data.EfakturaBridgeFactory
+import java.io.InputStream
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import sk.bizagent.efaktura.EfakturaSession
+import sk.bizagent.efaktura.LOCAL_TEST_BANNER
+import sk.bizagent.efaktura.XmlReadException
+import sk.bizagent.efaktura.readCappedXml
+
+class EfakturaBridgeViewModel : ViewModel() {
+    private val _state = MutableStateFlow<EfakturaSession.State>(EfakturaSession.State.Idle)
+    val state: StateFlow<EfakturaSession.State> = _state.asStateFlow()
+    private val _lastKey = MutableStateFlow<String?>(null)
+    val lastKey: StateFlow<String?> = _lastKey.asStateFlow()
+    private var readJob: Job? = null
+    private val session = EfakturaSession(viewModelScope) { uid, _ ->
+        EfakturaBridgeFactory.client(uid)
+            ?: throw IllegalStateException("Lokálny eFaktúra režim nie je nakonfigurovaný.")
+    }.also { created ->
+        created.onState = { _state.value = it }
+    }
+
+    val banner: String = LOCAL_TEST_BANNER
+    val configured: Boolean = EfakturaBridgeFactory.available()
+    val tenantHint: String = EfakturaBridgeFactory.tenantId()
+
+    fun onAccountChanged(uid: String?) {
+        readJob?.cancel()
+        readJob = null
+        _lastKey.value = null
+        val tenant = EfakturaBridgeFactory.tenantId().ifBlank { null }
+        session.onAccountChanged(uid, if (uid == null) null else tenant)
+    }
+
+    fun importUri(uri: Uri, open: (Uri) -> InputStream?) {
+        readJob?.cancel()
+        readJob = viewModelScope.launch {
+            val bytes = try {
+                val stream = open(uri) ?: throw XmlReadException("Súbor sa nepodarilo otvoriť.")
+                readCappedXml(stream)
+            } catch (error: CancellationException) {
+                throw error
+            } catch (error: Exception) {
+                session.showError(error.message ?: "XML sa nepodarilo prečítať.")
+                return@launch
+            }
+            _lastKey.value = session.importPrepared(bytes)
+        }
+    }
+
+    fun retry(operationKey: String) {
+        session.retry(operationKey)
+    }
+
+    fun refresh() {
+        session.refresh()
+    }
+
+    fun open(id: String) {
+        session.open(id)
+    }
+
+    fun cancel() {
+        readJob?.cancel()
+        readJob = null
+        session.cancel()
+    }
+
+    override fun onCleared() {
+        readJob?.cancel()
+        session.cancel()
+        super.onCleared()
+    }
+}

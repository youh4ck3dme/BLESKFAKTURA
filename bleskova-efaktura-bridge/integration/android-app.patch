@@ -0,0 +1,47 @@
+package com.example.data
+
+import android.util.Base64
+import com.example.BuildConfig
+import javax.crypto.Mac
+import javax.crypto.spec.SecretKeySpec
+import sk.bizagent.efaktura.AppCheckTokenProvider
+import sk.bizagent.efaktura.AuthTokenProvider
+import sk.bizagent.efaktura.EfakturaClient
+import sk.bizagent.efaktura.HttpEfakturaClient
+
+/**
+ * Debug-only local bridge. Release always returns null.
+ * HMAC secret, tenant and base URL come from local.properties, never from the release binary.
+ * The emulator token carries the current uid and no role. It does not create membership.
+ */
+object EfakturaBridgeFactory {
+    fun available(): Boolean {
+        return BuildConfig.EFAKTURA_BRIDGE_ENABLED &&
+            BuildConfig.BUILD_TYPE != "release" &&
+            BuildConfig.EFAKTURA_BASE_URL.isNotBlank() &&
+            BuildConfig.EFAKTURA_TENANT_ID.isNotBlank() &&
+            BuildConfig.EFAKTURA_EMULATOR_SECRET.isNotBlank()
+    }
+
+    fun tenantId(): String = if (BuildConfig.BUILD_TYPE == "release") "" else BuildConfig.EFAKTURA_TENANT_ID
+
+    fun client(uid: String): EfakturaClient? {
+        if (!available() || uid.isBlank()) return null
+        val secret = BuildConfig.EFAKTURA_EMULATOR_SECRET
+        val exp = System.currentTimeMillis() + 30 * 60_000
+        return HttpEfakturaClient(
+            BuildConfig.EFAKTURA_BASE_URL,
+            BuildConfig.EFAKTURA_TENANT_ID,
+            AuthTokenProvider { sign(secret, """{"uid":"$uid","typ":"user","exp":$exp}""") },
+            AppCheckTokenProvider { sign(secret, """{"typ":"appcheck","exp":$exp}""") }
+        )
+    }
+
+    private fun sign(secret: String, json: String): String {
+        val body = Base64.encodeToString(json.toByteArray(), Base64.URL_SAFE or Base64.NO_PADDING or Base64.NO_WRAP)
+        val mac = Mac.getInstance("HmacSHA256")
+        mac.init(SecretKeySpec(secret.toByteArray(), "HmacSHA256"))
+        val sig = Base64.encodeToString(mac.doFinal(body.toByteArray()), Base64.URL_SAFE or Base64.NO_PADDING or Base64.NO_WRAP)
+        return "emu.$body.$sig"
+    }
+}

+val efakturaLocalProperties = Properties().apply {
+  val file = rootProject.file("local.properties")
+  if (file.exists()) file.inputStream().use { load(it) }
+}
+
+fun efakturaLocal(name: String): String {
+  return efakturaLocalProperties.getProperty(name, "")
+    .replace("\\", "\\\\")
+    .replace("\"", "\\\"")
+    .lineSequence()
+    .firstOrNull()
+    .orEmpty()
+}
+
+fun efakturaConfigString(value: String): String = "\"$value\""
+
+fun efakturaPrivateOrLoopback(host: String): Boolean {
+  if (host == "localhost" || host == "127.0.0.1" || host == "10.0.2.2") return true
+  val parts = host.split(".")
+  if (parts.size != 4) return false
+  val nums = parts.map { it.toIntOrNull() ?: return false }
+  if (nums.any { it !in 0..255 }) return false
+  val a = nums[0]
+  val b = nums[1]
+  return a == 10 || (a == 192 && b == 168) || (a == 172 && b in 16..31)
+}
+
+fun efakturaCleartextHosts(): List<String> {
+  val hosts = linkedSetOf("127.0.0.1", "localhost", "10.0.2.2")
+  val raw = efakturaLocalProperties.getProperty("EFAKTURA_BASE_URL", "").trim()
+  val host = runCatching { URI(raw).host }.getOrNull()
+    ?.trim()
+    ?.lowercase()
+    ?.removePrefix("[")
+    ?.removeSuffix("]")
+  if (host != null && host.matches(Regex("[a-z0-9.-]+")) && efakturaPrivateOrLoopback(host)) {
+    hosts += host
+  }
+  return hosts.toList()
+}
+
+val efakturaDebugCleartextHosts = efakturaCleartextHosts()
+
+val generateEfakturaDebugNetworkSecurity = tasks.register("generateEfakturaDebugNetworkSecurity") {
+  val outputDir = layout.buildDirectory.dir("generated/efaktura/res")
+  outputs.dir(outputDir)
+  inputs.property("hosts", efakturaDebugCleartextHosts.joinToString(","))
+  doLast {
+    val xmlDir = outputDir.get().asFile.resolve("xml")
+    xmlDir.mkdirs()
+    val domains = efakturaDebugCleartextHosts.joinToString("\n") { host ->
+      "        <domain includeSubdomains=\"false\">$host</domain>"
+    }
+    xmlDir.resolve("network_security_config.xml").writeText(
+      """
+      <?xml version="1.0" encoding="utf-8"?>
+      <network-security-config>
+          <base-config cleartextTrafficPermitted="false" />
+          <domain-config cleartextTrafficPermitted="true">
+      $domains
+          </domain-config>
+      </network-security-config>
+      """.trimIndent() + "\n"
+    )
+  }
+}
